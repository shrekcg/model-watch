{
  "description": "Restore Model Watch state and run the model recommendation gate before each task.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/model-watch-hook.mjs",
            "timeout": 30,
            "additionalContextLimit": 900,
            "statusMessage": "正在恢复模型哨兵"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/model-watch-hook.mjs",
            "timeout": 30,
            "additionalContextLimit": 1600,
            "statusMessage": "模型哨兵正在评估当前请求"
          }
        ]
      }
    ]
  }
}
